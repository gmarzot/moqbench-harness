# Terraform state carries live resource IDs and IPs; the workspace dirs too.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfstate.d/

# Measurement output: regenerated by a run, and large.
results/

# Local relay binaries staged for deployment (hundreds of MB).
patches/bin/

# One tester's environment settings: profile name, SSH key path, egress IP
# (see oci/envs/*.local.tfvars.example).
*.local.tfvars
*.local.toml

# Local-only relay definitions (see relays.local.sh.example), and anything that
# could carry credentials. OCI auth lives in ~/.oci and is never copied here;
# these catch an accidental copy or a saved plan, which embeds variable values.
relays.local.sh
*.tfplan
*.pem
*.key
*.p12
*.pfx
.env
.oci/
oci_api_key*
*session*token*

# Python bytecode.
__pycache__/
*.pyc

# The selected testbed's host list, written by bin/testbed.sh (per tester).
.testbed/
wheels/

# Local patches applied by build scripts; never tracked.
patches/local/
