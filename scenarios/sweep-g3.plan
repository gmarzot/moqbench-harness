# All-Graviton3 video-shape sweep: moqx at 60 threads, three load hosts, the
# publisher on load host 2, draft 18. KEY=VALUE lines set the environment of
# the points after them.
PUB_HOST=client:2
DRAFT=18
THREADS=60
STEP_SUBS=250
JOIN=10
STAGGER=0.02
LATENCY_MS=500
SHORTFALL=0.7
DELIVERY_TIMEOUT=500
MP_THREADS=32
MP_RAMP=64
# moqx packet budgets and GRO as moqx-run.sh's own defaults, which the scratch sweep ran with.
MOQX_SEND=16
MOQX_RECV=256
MOQX_GRO=
# tool  build  shape  max/box  seconds  run
aio     pgo    1080p   5000    600      aio-pgo60-3b-1080-ps+g3
aio     pgo    720p    8000    700      aio-pgo60-3b-720-ps+g3
aio     pgo    480p   10000    800      aio-pgo60-3b-480-ps+g3
mp      pgo    1080p   5000    420      mp-pgo60-3b-1080-ps+g3
mp      pgo    720p    8000    520      mp-pgo60-3b-720-ps+g3
mp      pgo    480p   10000    600      mp-pgo60-3b-480-ps+g3
aio     reg    1080p   5000    600      aio-reg60-3b-1080-ps+g3
aio     reg    720p    8000    700      aio-reg60-3b-720-ps+g3
aio     reg    480p   10000    800      aio-reg60-3b-480-ps+g3
