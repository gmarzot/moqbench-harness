# moqx at 48 threads on one c7gn.12xlarge, two c7gn.12xlarge load hosts, the
# publisher on load host 2, draft 18. Tune with RPS=1 first: the A/B against RPS=0. KEY=VALUE lines set
# the environment of the points after them.
PUB_HOST=client:2
DRAFT=18
THREADS=48
JOIN=10
STAGGER=0.02
LATENCY_MS=500
SHORTFALL=0.7
DELIVERY_TIMEOUT=500
MP_THREADS=32
# moqx packet budgets and GRO as moqx-run.sh's own defaults.
MOQX_SEND=16
MOQX_RECV=256
MOQX_GRO=
# tool  build  shape  max/box  seconds  run
STEP_SUBS=250
MP_RAMP=64
mp      pgo    1080p   7000    420      mp-pgo48-2b-1080-12x-rps
