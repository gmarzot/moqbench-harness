# moqx at 48 threads on one c7gn.12xlarge, two c7gn.12xlarge load hosts, the
# publisher on load host 2, draft 18. Tune with RPS=0 first. KEY=VALUE lines set
# the environment of the points after them.
PUB_HOST=client:2
DRAFT=18
THREADS=48
JOIN=10
STAGGER=0.02
LATENCY_MS=500
SHORTFALL=0.7
DELIVERY_TIMEOUT=500
MP_THREADS=32
# moqx packet budgets and GRO as moqx-run.sh's own defaults.
MOQX_SEND=16
MOQX_RECV=256
MOQX_GRO=
# tool  build  shape  max/box  seconds  run
STEP_SUBS=250
MP_RAMP=64
mp      pgo    1080p   7000    420      mp-pgo48-2b-1080-12x
aio     pgo    1080p   6000    800      aio-pgo48-2b-1080-12x
# 3.7x the bitrate per subscriber: slower ramps in subscribers.
STEP_SUBS=50
MP_RAMP=32
mp      pgo    2160p   5000    540      mp-pgo48-2b-2160-12x
aio     pgo    2160p   2000    700      aio-pgo48-2b-2160-12x
# One subscriber host.
SUB_HOSTS=client:1
STEP_SUBS=250
MP_RAMP=64
mp      pgo    1080p  13000    650      mp-pgo48-1b-1080-12x
