+    // Overridable via MOQ_UDP_BUFFER_BYTES so operators can match host tuning.
+    const DEFAULT_SOCKET_BUFFER_SIZE: usize = 16 * 1024 * 1024;
+    let socket_buffer_size: usize = std::env::var("MOQ_UDP_BUFFER_BYTES")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(DEFAULT_SOCKET_BUFFER_SIZE);
+    let SOCKET_BUFFER_SIZE = socket_buffer_size;
+    #[allow(non_snake_case)]
+    if let Err(e) = socket.set_recv_buffer_size(SOCKET_BUFFER_SIZE) {
+        tracing::warn!("could not set UDP recv buffer size: {}", e);
+    }
+    if let Err(e) = socket.set_send_buffer_size(SOCKET_BUFFER_SIZE) {
+        tracing::warn!("could not set UDP send buffer size: {}", e);
+    }
+
     socket
