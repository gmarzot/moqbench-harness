diff --git a/rs/moq-net/src/model/track.rs b/rs/moq-net/src/model/track.rs
index 3c01801..9e16659 100644
--- a/rs/moq-net/src/model/track.rs
+++ b/rs/moq-net/src/model/track.rs
@@ -2567,6 +2567,30 @@ impl Subscriber {
 			SubscriberKind::Spliced(spliced) => spliced.latest(),
 		}
 	}
+
+	/// The largest Location observed on this track: the latest group and the id
+	/// of the last object written in it.
+	///
+	/// draft-16 §9.2.2.7 requires this in SUBSCRIBE_OK (LARGEST_OBJECT) once the
+	/// track has content. A spliced subscriber only exposes the sequence, so the
+	/// object is reported as 0 there.
+	pub fn latest_location(&self) -> Option<(u64, u64)> {
+		match &self.inner {
+			SubscriberKind::Plain(plain) => {
+				let state = plain.state.read();
+				let sequence = state.max_sequence?;
+				// frame_count counts completed plus in-flight frames, so the
+				// largest object id written is one less.
+				let object = state
+					.lookup
+					.get(&sequence)
+					.map(|slot| slot.group.frame_count().saturating_sub(1) as u64)
+					.unwrap_or(0);
+				Some((sequence, object))
+			}
+			SubscriberKind::Spliced(spliced) => spliced.latest().map(|sequence| (sequence, 0)),
+		}
+	}
 }
 
