 const KEEPALIVE_INTERVAL: Duration = Duration::from_secs(10);
 
+/// Request larger UDP socket buffers, in bytes, from `MOQ_UDP_BUFFER_BYTES`.
+///
+/// Neither quinn nor quiche sizes the socket itself, so a relay otherwise runs
+/// on the kernel default while the host is tuned for far more. Under fan-out
+/// the send buffer is what absorbs a burst to many peers; when it is too small
+/// the kernel drops datagrams the relay believed it had sent. Unset leaves the
+/// default in place. The kernel clamps to net.core.{r,w}mem_max.
+fn set_buffer_sizes(socket: &Socket) {
+	let Some(bytes) = std::env::var("MOQ_UDP_BUFFER_BYTES")
+		.ok()
+		.and_then(|v| v.parse::<usize>().ok())
+	else {
+		return;
+	};
+	if let Err(err) = socket.set_recv_buffer_size(bytes) {
+		tracing::warn!(?err, bytes, "could not set UDP recv buffer size");
+	}
+	if let Err(err) = socket.set_send_buffer_size(bytes) {
+		tracing::warn!(?err, bytes, "could not set UDP send buffer size");
+	}
+}
+
 /// Bind a UDP socket, making an IPv6 socket dual-stack so it also serves IPv4.
 pub fn udp(addr: SocketAddr) -> std::io::Result<UdpSocket> {
 	let domain = if addr.is_ipv4() { Domain::IPV4 } else { Domain::IPV6 };
 	let socket = Socket::new(domain, Type::DGRAM, Some(Protocol::UDP))?;
 	make_dual_stack(&socket, addr);
+	set_buffer_sizes(&socket);
+	socket.bind(&addr.into())?;
+	Ok(socket.into())
+}
+
+/// Bind a UDP socket with SO_REUSEPORT so several sockets can share one port.
+///
+/// The kernel then hashes each 4-tuple to one of them, letting a server run an
+/// independent receive path per worker instead of funnelling every datagram
+/// through a single socket. Note that 4-tuple hashing does not follow QUIC
+/// connection migration; CID-aware steering (eBPF) is needed for that.
+pub fn udp_reuseport(addr: SocketAddr) -> std::io::Result<UdpSocket> {
+	let domain = if addr.is_ipv4() { Domain::IPV4 } else { Domain::IPV6 };
+	let socket = Socket::new(domain, Type::DGRAM, Some(Protocol::UDP))?;
+	socket.set_reuse_address(true)?;
+	socket.set_reuse_port(true)?;
+	make_dual_stack(&socket, addr);
+	set_buffer_sizes(&socket);
 	socket.bind(&addr.into())?;
 	Ok(socket.into())
 }
