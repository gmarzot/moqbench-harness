# Personal defaults for the commands in bin/. Copy to .env (gitignored) and keep
# only what you need. A variable set in your shell overrides the same one here.
# Nothing secret belongs here: OCI credentials stay in ~/.oci/config.

# Environment for new deployments when --env is not given
# (./bin/testbed.sh <name> up). Existing deployments keep their own.
TESTBED_ENV=moqbench-testbed

# SSH private key and login, when not taken from the selected testbed.
# KEY=~/.ssh/id_ed25519
# RUSER=ubuntu

# Which optional load generators ./bin/testbed-provision.sh installs, and the
# MoQT draft moq-bench is built for (16, or 18 for moqx only).
# TOOLS="aiomoqt moqbench"
# MOQBENCH_DRAFT=16

# A local aiomoqt build to install instead of the PyPI release, kept under
# wheels/ (gitignored). Without it, provisioning reinstalls the PyPI version.
# AIOMOQT_WHEEL=wheels/aiomoqt-<version>-py3-none-any.whl
# Optional native installer run on each host with the staged wheel as $1.
# It installs the pair into ~/Projects/aiomoqt/.venv and must fail on errors.
# AIOMOQT_INSTALL_SCRIPT=.testbed/install-aiomoqt-native.sh
# Refuse a load run if any participant has a different transport version.
# AIOPQUIC_EXPECT_VERSION=0.7.0.dev199+g607caa2

# Relays ./bin/testbed-provision.sh deploys (./bin/relay-deploy.sh each), and
# a host with a prebuilt tree to pull as well (moxygen's moqperf tools).
# RELAYS="moqx"
# SRC=user@host:Projects

# Relay worker threads for relay-capacity.sh and relay-load.sh.
# THREADS=8

# Current moq-dev: THREADS selects independent QUIC workers.
# MOQDEV_PIN=false
# MOQDEV_CC=delay
# MOQDEV_AUX_THREADS=2
# MOQDEV_SRC=../moq-dev
# MOQDEV_REF=origin/main
# MOQDEV_CPU=x86-64-v3
# BUILD_JOBS=4
