#!/usr/bin/env python3
"""Watch a load run on a local page, without touching it.

  ./bin/live-dashboard                      # the selected testbed's hosts
  ./bin/live-dashboard --replay <run dir>   # a finished run, on the same page

Then open http://127.0.0.1:8765/. Live mode only reads what a run already
writes: one ssh connection per host follows the monitor's file and the load
tool's log with a niced tail. It starts no agent and opens no port on a host,
and the run does not know it exists, so it can attach, detach or fail at any
time.
"""
import argparse
import csv
from collections import deque
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from urllib.parse import parse_qs, urlparse

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'lib'))
import telemetry  # noqa: E402

PAGE = ROOT / 'lib/live-dashboard.html'
RESULTS = ROOT / 'results'
SHAPES = json.loads((ROOT / 'scenarios/shapes.json').read_text())
WRITTEN_BY = re.compile(r'Written by moqbench from plans/(.+?)\.toml and suites/(.+?)\.toml')
MONITOR_FILES = '/tmp/moqbench-monitor-*.jsonl'
TOOL_LOG = '/tmp/loadsub.log'
MAX_ROWS = 40000  # about three hours of one-second samples from three hosts
DISCOVER_S = 15   # how often a host is asked for a newer monitor file


def list_command():
    return f'ls -t {MONITOR_FILES} 2>/dev/null | head -1'


def follow_command(path, lines=1):
    return f'exec nice -n 19 tail -n {lines} -F {shlex.quote(path)} 2>/dev/null'


class Store:
    """Rows of the current run, in arrival order, for the page's history and event stream."""

    def __init__(self, **meta):
        self.cond = threading.Condition()
        self.rows = deque(maxlen=MAX_ROWS)
        self.seq = 0
        self.run = None
        self.meta = meta

    def add(self, row):
        with self.cond:
            self.seq += 1
            self.rows.append(dict(row, seq=self.seq))
            self.cond.notify_all()

    def new_run(self, name):
        """Monitor files carry the run's start time, so a later name is a later run."""
        with self.cond:
            if self.run is not None and name <= self.run:
                return
            self.run = name
            self.rows.clear()
            self.seq += 1
            self.rows.append(dict(kind='run', name=name, seq=self.seq))
            if self.meta.get('point'):
                self.seq += 1
                self.rows.append(dict(kind='point', info=self.meta['point'], seq=self.seq))
            self.cond.notify_all()

    def set_point(self, info):
        with self.cond:
            self.meta['point'] = info
            self.seq += 1
            self.rows.append(dict(kind='point', info=info, seq=self.seq))
            self.cond.notify_all()

    def since(self, seq):
        with self.cond:
            return [r for r in self.rows if r['seq'] > seq]


def sample_row(host, role, a, b, hz):
    """One host's rates between two monitor samples."""
    r = telemetry.rates(a, b, hz)
    row = dict(kind='host', host=host, role=role, t=b['t_wall'], busy=r['host_busy_pct'],
               hottest=r['hottest_cpu_pct'], tx_gbps=r['net_tx_mbps'] / 1e3, rx_gbps=r['net_rx_mbps'] / 1e3,
               tx_mpps=r['net_tx_kpps'] / 1e3, rx_mpps=r['net_rx_kpps'] / 1e3, steal=telemetry.steal_pct(a, b),
               udp_errors=r['udp_InErrors_delta'] + r['udp_SndbufErrors_delta'],
               allowance=r['nic_allowance_exceeded_delta'])
    if r['process_cores'] != '':
        row['cores'] = r['process_cores']
    thread = telemetry.hottest_thread_pct(a, b, hz)
    if thread is not None:
        row['hot_thread'] = thread
    ca, cb = a.get('comm'), b.get('comm')
    if ca and cb and cb['ticks'] >= ca['ticks']:
        row['tool_cores'] = (cb['ticks'] - ca['ticks']) / hz / r['interval_s']
        row['tool_rss_gb'] = cb['rss_bytes'] / 2**30
    return row


def tool_row(line, year=2000):
    """A load tool's interval line as subscribers and worst latency, or None."""
    m = telemetry.ROW.match(line)
    if m:
        g = m.groups()
        return dict(subs=int(g[8]), latency_ms=telemetry.ms(g[10]), metric='p90', action=g[13].strip(), elapsed=int(g[0]))
    m = telemetry.AGG.match(line)
    if m:
        g = m.groups()
        return dict(subs=int(g[6]), latency_ms=float(g[11]), metric='slowest', resets=int(g[13]), stamp=g[:5])
    return None


def sweep_plan(path):
    """A sweep plan's header comments, and its points with the settings in force and their notes."""
    header, points, env, note = {}, [], {}, ''
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if line.startswith('#'):
            text = line[1:].strip()
            key, _, value = text.partition(': ')
            written = WRITTEN_BY.search(text)
            if key == 'note':
                note = value
            elif key in ('plan', 'suite') and not points:
                header[key] = value
            elif written:
                header['plan_name'], header['suite_name'] = written.groups()
            continue
        setting = re.match(r'([A-Z_][A-Z0-9_]*)=(.*)$', line)
        fields = line.split('#')[0].split()
        if setting:
            env[setting[1]] = setting[2]
        elif len(fields) == 6:
            points.append(dict(run=fields[5], env=dict(env), note=note))
            note = ''
    return header, points


def description(kind, name):
    """A plan's or suite's description from the repo, for sweeps written before plans carried it."""
    try:
        import tomllib
        return tomllib.loads((ROOT / f'{kind}s' / f'{name}.toml').read_text()).get('description', '')
    except (ImportError, OSError, ValueError):
        return ''


def match(path, pattern):
    try:
        found = re.search(pattern, Path(path).read_text(errors='replace'), re.M)
    except OSError:
        return None
    return found and found.group(1)


def number(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def cpu_count(spec):
    """How many CPUs a list such as 4-7 or 0,2-3 names."""
    total = 0
    for part in spec.split(','):
        first, _, last = part.partition('-')
        total += int(last or first) - int(first) + 1
    return total


def relay_instance(results, plan_name):
    """The relay's instance type, from the plan that ran this point."""
    import tomllib
    import config
    try:
        data = tomllib.loads((Path(results) / 'moqbench' / plan_name / 'plan.toml').read_text())
        return config.load_deployment(data['deployment']).relay['instance']
    except (OSError, ValueError, KeyError, IndexError, TypeError, config.ConfigError):
        return None


def relay_threads(relay, env):
    """The relay's thread layout; aiomoqt-relay's comes from its workers, not THREADS."""
    if relay == 'aiomoqt':
        workers = int(env.get('AIOMOQT_WORKERS') or 1)
        return f'{workers} picoquic worker{"s" if workers != 1 else ""} + 1 Python event loop'
    threads = env.get('THREADS')
    return f'{threads} thread{"s" if threads != "1" else ""}' if threads else None


def viewer_tracks(env):
    """The tracks each aiomoqt load viewer takes."""
    flags = env.get('AIOMOQT_EXTRA', '').split()
    tracks = ['video']
    if '--audio' in flags:
        tracks.append('audio on ' + ('datagrams' if {'-D', '--datagram'} & set(flags) else 'streams'))
    if '--catalog' in flags:
        tracks.append('catalog')
    return ', '.join(tracks)


def relay_cpus(env, run_dir, instance):
    """The CPUs the relay may run on and the machine they belong to."""
    total, _, model = (match(run_dir / 'versions.txt', r'^relay-cpu:[ \t]*(.+)$') or '').partition(' vcpu, ')
    spec = env.get('RELAY_CPUS', '')
    if spec:
        of = f' of {total} vCPU' if total else ' vCPU'
        where = f'cores {spec} ({cpu_count(spec)}{of})'
    else:
        where = f'not pinned, {total} vCPU' if total else 'not pinned'
    return ', '.join(filter(None, (where, model, instance)))


def point_info(run_dir):
    """What a sweep point tests and why, from the files the sweep writes before it starts."""
    run_dir = Path(run_dir)
    try:
        pt = json.loads((run_dir / 'sweep-point.json').read_text())
    except (OSError, ValueError):
        return None
    plan_file = run_dir.parent / 'plan'
    header, points = sweep_plan(plan_file) if plan_file.exists() else ({}, [])
    index = next((i for i, p in enumerate(points) if p['run'] == pt.get('run')), None)
    here = points[index] if index is not None else {}
    env = {**here.get('env', {}), **pt.get('env', {})}
    plan = header.get('plan_name') or run_dir.parent.name.removeprefix('sweep-')
    purpose = header.get('plan') or (description('plan', header['plan_name']) if 'plan_name' in header else '')
    relay = pt.get('relay', 'moqx')
    label = match(run_dir / 'run.txt', r'^== \S+ vs (\S+)') or relay
    key = 'aiomoqt-relay' if relay == 'aiomoqt' else relay
    version = match(run_dir / 'versions.txt', rf'^{re.escape(key)}:[ \t]*(\S+)')
    if relay == 'moqx' and not version:
        version = Path(pt.get('moqx_source') or 'release').name
    aiopquic = match(run_dir / 'versions.txt', r'^aiomoqt-relay:.*\baiopquic[ \t]+(\S+)') if relay == 'aiomoqt' else None
    boxes, shape, bound = pt.get('load_boxes', 1), pt.get('shape', ''), env.get('LATENCY_MS', '500')
    mbps = SHAPES.get(shape, {}).get('nominal_mbps')
    # The load commands as run, then the plan's settings.
    sub = match(run_dir / 'run-settings.txt', r'^subscriber_command_per_host=(.*)$') or ''
    flag = lambda pattern, key: number(next(iter(re.findall(pattern, sub)), None) or env.get(key))  # noqa: E731
    if pt.get('tool') == 'mp':
        each = flag(r'--subscriber_ramp=(\S+)', 'MP_RAMP')
        tool = f'moqperf, {env.get("MP_THREADS", "32")} threads per host'
        ramp = each * boxes if each else None
        stop = f'slowest object over {bound} ms, or a reset'
    else:
        step, join = flag(r'--step-subs (\S+)', 'STEP_SUBS'), flag(r' -j (\S+)', 'JOIN')
        tool = f'aiomoqt, K={step:g} viewers per load process' if step else 'aiomoqt'
        ramp = step / join * boxes if step and join else None
        stop = f'worst-sub p90 over {bound} ms; ' + (
            'the first ceiling ends the run' if env.get('STOP_AT_CEILING') == '1' else 'runs to the time limit')
    facts = [
        ('Plan', f'{plan}, point {index + 1} of {len(points)}' if index is not None else plan),
        ('Relay', ' '.join(filter(None, (label, version))) + (f' on aiopquic {aiopquic}' if aiopquic else '')),
        ('Threads', relay_threads(relay, env)),
        ('CPUs', relay_cpus(env, run_dir, relay_instance(run_dir.parent.parent, header.get('plan_name')))),
        ('Tool', tool),
        ('Viewers', None if pt.get('tool') == 'mp' else viewer_tracks(env)),
        ('Video', f'{shape}, {mbps:g} Mbps per subscriber' if mbps else shape),
        ('Draft', env.get('DRAFT', '16')),
        ('Ramp', f'{ramp:g} subscribers/s' if ramp else 'n/a'),
        ('Bound', stop),
    ]
    workers = int(env.get('AIOMOQT_WORKERS') or 1) if relay == 'aiomoqt' else None
    title = f'{label}, {shape}' + (f', {workers} worker{"s" if workers != 1 else ""}' if workers else '')
    return dict(run=pt.get('run'), title=title, purpose=purpose, note=here.get('note', ''),
                seconds=pt.get('duration_s'), facts=[f for f in facts if f[1]])


def current_point(results=RESULTS):
    """The sweep point now running: the newest sweep-point.json whose run.txt has no exit status yet."""
    try:
        newest = max(Path(results).glob('sweep-*/*/sweep-point.json'), key=lambda p: p.stat().st_mtime)
    except (ValueError, OSError):
        return None
    try:
        if 'run_exit_status=' in (newest.parent / 'run.txt').read_text(errors='replace'):
            return None
    except OSError:
        pass
    return point_info(newest.parent)


def plan_info(inventory, results=RESULTS):
    """The newest moqbench plan, if it targets this testbed, for the header before its first point."""
    try:
        import tomllib
        import config
        deployment = json.loads(Path(inventory).read_text()).get('deployment')
        path = max(Path(results).glob('moqbench/*/plan.toml'), key=lambda p: p.stat().st_mtime)
        data = tomllib.loads(path.read_text())
    except (ImportError, OSError, ValueError):
        return None
    if not deployment or data.get('deployment') != deployment:
        return None
    facts = [('Plan', path.parent.name), ('Deployment', deployment)]
    try:
        nodes = config.load_deployment(deployment).nodes
        facts.append(('Hosts', ', '.join(f'{n["name"]} {n["instance"]}' for n in nodes)))
    except (config.ConfigError, OSError, ValueError, KeyError):
        pass
    facts += [('Relays', ', '.join(data.get('relays', []))), ('Suites', ', '.join(data.get('suites', [])))]
    if data.get('builds'):
        facts.append(('Builds', ', '.join(f'{k} {v}' for k, v in data['builds'].items())))
    return dict(run=None, title=path.parent.name, purpose=data.get('description', ''),
                note='Setting up; the first point has not started', seconds=None, facts=facts)


def header(store, inventory, results=RESULTS):
    """The running point; before any point of this session, the plan setting up the testbed."""
    info = current_point(results)
    if not info and not (store.meta.get('point') or {}).get('run'):
        info = plan_info(inventory, results)
    return info


def follow_points(store, stop, inventory, results=RESULTS):
    while not stop.is_set():
        info = header(store, inventory, results)
        if info and info != store.meta.get('point'):
            store.set_point(info)
        stop.wait(5)


class Host:
    """Follows one host's monitor file and, on load hosts, its tool log."""

    def __init__(self, name, role, address, ssh, store, stop):
        self.name, self.role, self.address, self.ssh, self.store, self.stop = name, role, address, ssh, store, stop
        self.path = None
        self.proc = None
        self.offset = 0.0  # local clock minus this host's clock

    def command(self, remote):
        return [*self.ssh, f'{self.address}', remote]

    def start(self):
        threading.Thread(target=self.discover, daemon=True).start()
        if self.role == 'load':
            threading.Thread(target=self.follow_tool, daemon=True).start()

    def discover(self):
        while not self.stop.is_set():
            try:
                newest = subprocess.run(self.command(list_command()), capture_output=True, text=True,
                                        timeout=20).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                newest = ''
            if newest and newest != self.path:
                self.path = newest
                self.store.new_run(Path(newest).stem)
                threading.Thread(target=self.follow_monitor, args=(newest,), daemon=True).start()
            self.stop.wait(DISCOVER_S)

    def follow_monitor(self, path):
        hz = 100
        try:
            head = subprocess.run(self.command(f'head -n 1 {shlex.quote(path)}'), capture_output=True, text=True,
                                  timeout=20).stdout
            hz = json.loads(head).get('clock_ticks', hz)
        except (OSError, subprocess.SubprocessError, ValueError):
            pass
        proc = subprocess.Popen(self.command(follow_command(path)), stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
        self.store.meta.setdefault('procs', []).append(proc)
        prev = None
        for line in proc.stdout:
            if self.stop.is_set() or path != self.path:
                break
            try:
                sample = json.loads(line)
            except ValueError:
                continue
            if 'monotonic' not in sample:
                continue
            self.offset = time.time() - sample['t_wall']
            if prev:
                try:
                    self.store.add(sample_row(self.name, self.role, prev, sample, hz))
                except (KeyError, ValueError, ZeroDivisionError):
                    pass
            prev = sample
        proc.terminate()

    def follow_tool(self):
        while not self.stop.is_set():
            proc = subprocess.Popen(self.command(follow_command(TOOL_LOG, lines=0)), stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True, errors='replace')
            self.store.meta.setdefault('procs', []).append(proc)
            for line in proc.stdout:
                row = tool_row(line)
                if row:
                    self.store.add(dict(row, kind='tool', host=self.name, t=time.time() - self.offset))
            self.stop.wait(5)


def attach(inventory, store, stop, control):
    """Start following every host of the testbed."""
    inv = json.loads(Path(inventory).read_text())
    user = inv.get('user') or 'ubuntu'
    ssh = ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '-o', 'StrictHostKeyChecking=accept-new',
           '-o', 'ServerAliveInterval=15', '-o', 'ControlMaster=auto', '-o', 'ControlPersist=30',
           '-o', f'ControlPath={control}/%C', '-l', user]
    if inv.get('ssh_key_file'):
        ssh += ['-i', inv['ssh_key_file']]
    hosts = [('relay', 'relay', inv['relay']['public'])]
    hosts += [(f'load-{i + 1}', 'load', c['public']) for i, c in enumerate(inv['clients'])]
    store.meta['hosts'] = [dict(name=n, role=r) for n, r, _ in hosts]
    threading.Thread(target=follow_points, args=(store, stop, inventory), daemon=True).start()
    for name, role, address in hosts:
        Host(name, role, address, ssh, store, stop).start()


def replay(run_dir, store):
    """Load a finished run's saved telemetry and tool logs."""
    run_dir = Path(run_dir)
    store.new_run(run_dir.name)
    info = point_info(run_dir)
    if info:
        store.set_point(info)
    hosts, offsets = [], {}
    for path in sorted(run_dir.glob('telemetry-*.jsonl')):
        stem = path.stem.removeprefix('telemetry-')
        name, role = ('relay', 'relay') if stem == 'relay' else (f'load-{int(stem[3:]) + 1}', 'load')
        hosts.append(dict(name=name, role=role))
        records = [json.loads(line) for line in path.open()]
        hz = records[0].get('clock_ticks', 100)
        samples = [r for r in records if 'monotonic' in r]
        offsets[name] = samples[0]['t_wall'] - samples[0]['monotonic'] if samples else 0
        for a, b in zip(samples, samples[1:]):
            store.add(sample_row(name, role, a, b, hz))
    store.meta['hosts'] = hosts
    for log in sorted(run_dir.glob('sub[0-9]*.log')):
        index = int(log.stem[3:])
        name = f'load-{index + 1}'
        base = None
        report = run_dir / f'sub{index}' / 'loadreport.csv'
        if report.exists():
            rows = list(csv.DictReader(report.open()))
            if rows:
                base = float(rows[0]['t_monotonic']) + offsets.get(name, 0)
        first = None
        year = time.gmtime(offsets.get(name) or time.time()).tm_year
        for line in log.open(errors='replace'):
            row = tool_row(line)
            if not row:
                continue
            if 'stamp' in row:
                row['t'] = telemetry.calendar_seconds(year, row.pop('stamp'))
            elif base is not None:
                first = row['elapsed'] if first is None else first
                row['t'] = base + row['elapsed'] - first
            else:
                continue
            store.add(dict(row, kind='tool', host=name))


class Handler(BaseHTTPRequestHandler):
    store = None

    def log_message(self, *args):
        pass

    def send_body(self, body, content_type):
        self.send_response(200)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        url = urlparse(self.path)
        if url.path == '/':
            self.send_body(PAGE.read_bytes(), 'text/html; charset=utf-8')
        elif url.path == '/history':
            meta = {k: v for k, v in self.store.meta.items() if k != 'procs'}
            body = json.dumps(dict(meta=meta, rows=self.store.since(0))).encode()
            self.send_body(body, 'application/json')
        elif url.path == '/events':
            self.events(int(parse_qs(url.query).get('since', ['0'])[0]))
        else:
            self.send_error(404)

    def events(self, seq):
        self.send_response(200)
        self.send_header('Content-Type', 'text/event-stream')
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        try:
            while True:
                with self.store.cond:
                    self.store.cond.wait(5)
                rows = self.store.since(seq)
                if rows:
                    seq = rows[-1]['seq']
                self.wfile.write(f'data: {json.dumps(rows)}\n\n'.encode() if rows else b': keepalive\n\n')
                self.wfile.flush()
        except OSError:
            pass


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('--inventory', default=str(ROOT / '.testbed/inventory.json'), help='testbed host list (default: %(default)s)')
    p.add_argument('--replay', metavar='RUN_DIR', help='show a finished run instead of following hosts')
    p.add_argument('--port', type=int, default=8765, help='local port (default: %(default)s)')
    p.add_argument('--slo-ms', type=float, default=500, help='latency line on the chart (default: %(default)s)')
    p.add_argument('--load-limit', type=float, default=85, help='load-host busy line (default: %(default)s)')
    args = p.parse_args()
    store = Store(slo_ms=args.slo_ms, load_limit=args.load_limit, mode='replay' if args.replay else 'live',
                  source=str(args.replay or args.inventory), hosts=[])
    stop = threading.Event()
    control = tempfile.mkdtemp(prefix='mbd')
    if args.replay:
        replay(args.replay, store)
    else:
        attach(args.inventory, store, stop, control)
    Handler.store = store
    server = ThreadingHTTPServer(('127.0.0.1', args.port), Handler)
    server.daemon_threads = True
    print(f'http://127.0.0.1:{args.port}/', flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        for proc in store.meta.get('procs', []):
            proc.terminate()
        shutil.rmtree(control, ignore_errors=True)


if __name__ == '__main__':
    main()
